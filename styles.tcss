Input {
    width: 40;
    border: round #6ca0f5;
    height: 3;
    margin: 4;
}

Input:focus {
    border: round #f56c6c;
    background: black;
}

Screen {
    align: center middle;
    border: heavy #6ca0f5;
}

#stats {
    layout: grid;
    grid-size: 4 2;
    grid-columns: 35;
    grid-rows: 6;
    grid-gutter: 1 2;
    width: auto;
    height: auto;
}

.stat {
    border: round #6ca0f5;
    width: 33;
    height: 8;
    padding: 1 2;

    align: center middle;
}

.stat Label {
    width: 100%;
    height: 2;

    content-align: center middle;
    text-align: center;
}

.stat:hover {
    border: round #f56c6c;
}